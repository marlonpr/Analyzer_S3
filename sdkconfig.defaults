CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

CONFIG_START_ANALYZER_GPIO_SQW=4
CONFIG_START_ANALYZER_GPIO_COMMIT=5
CONFIG_START_ANALYZER_GPIO_REFRESH=6
CONFIG_START_ANALYZER_GPIO_ESP02_SQW=7
CONFIG_START_ANALYZER_GPIO_ESP02_COMMIT=15
CONFIG_START_ANALYZER_GPIO_ESP02_REFRESH=16
